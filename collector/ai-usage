#!/usr/bin/env python3
"""Horizon ai-usage collector — provider dispatch + cache + StepFun auth."""

from __future__ import annotations

import argparse
import getpass
import json
import sys
from pathlib import Path

# Allow `collector/ai-usage` to import sibling packages when executed as a script.
_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from cache import stale_payload, write_success  # noqa: E402
from providers import ProviderError, error_payload  # noqa: E402
from providers.codex import CodexProvider  # noqa: E402
from providers.cursor import CursorProvider  # noqa: E402
from providers.stepfun import StepFunProvider  # noqa: E402
from secret_store import SecretStoreError  # noqa: E402
from secret_store import configured as secret_configured  # noqa: E402
from secret_store import delete as secret_delete  # noqa: E402
from secret_store import set as secret_set  # noqa: E402

PROVIDERS = {
    "codex": CodexProvider,
    "cursor": CursorProvider,
    "stepfun": StepFunProvider,
}


def eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


def build_provider(provider_id: str, auth_file: str | None):
    cls = PROVIDERS.get(provider_id)
    if cls is None:
        return None
    if provider_id == "codex":
        return cls(auth_path=Path(auth_file).expanduser() if auth_file else None)
    if provider_id == "cursor":
        return cls(state_db=Path(auth_file).expanduser() if auth_file else None)
    return cls()


def cmd_auth(args: argparse.Namespace) -> int:
    if args.provider != "stepfun":
        eprint("Only `ai-usage auth stepfun …` is supported")
        return 2
    action = args.auth_action
    try:
        if action == "set":
            # Never accept --token. Prompt with echo suppressed on a TTY;
            # when stdin is piped (non-TTY), read one line so automation need
            # not put the secret in argv/history.
            if sys.stdin.isatty():
                token = getpass.getpass("Oasis token: ")
            else:
                token = sys.stdin.readline()
            token = (token or "").strip()
            if not token:
                eprint("No token provided")
                return 1
            secret_set("stepfun", "oasis-token", token)
            # Verify without printing secrets.
            try:
                from providers.stepfun import (  # noqa: WPS433
                    StepFunProvider,
                    derive_oasis_app_id,
                    derive_oasis_webid,
                )

                webid = derive_oasis_webid(token)
                if not webid:
                    print("auth_failed")
                    return 1
                app_id = derive_oasis_app_id(token) or "20700"
                StepFunProvider()._post_json(  # noqa: SLF001
                    "/api/step.openapi.devcenter.Dashboard/QueryStepPlanRateLimit",
                    token,
                    webid,
                    app_id,
                    {},
                )
                print("working")
                return 0
            except Exception:  # noqa: BLE001
                print("auth_failed")
                return 1
        if action == "status":
            if not secret_configured("stepfun", "oasis-token"):
                print("missing")
                return 0
            try:
                from providers.stepfun import (  # noqa: WPS433
                    StepFunProvider,
                    derive_oasis_app_id,
                    derive_oasis_webid,
                )
                from secret_store import get as secret_get

                token = secret_get("stepfun", "oasis-token")
                if not token:
                    print("missing")
                    return 0
                webid = derive_oasis_webid(token)
                if not webid:
                    print("auth_failed")
                    return 0
                app_id = derive_oasis_app_id(token) or "20700"
                StepFunProvider()._post_json(  # noqa: SLF001
                    "/api/step.openapi.devcenter.Dashboard/QueryStepPlanRateLimit",
                    token,
                    webid,
                    app_id,
                    {},
                )
                print("working")
            except Exception:  # noqa: BLE001
                print("auth_failed")
            return 0
        if action == "clear":
            secret_delete("stepfun", "oasis-token")
            print("cleared")
            return 0
    except SecretStoreError as exc:
        eprint(str(exc))
        return 1
    eprint(f"Unknown auth action: {action}")
    return 2


def cmd_status(args: argparse.Namespace) -> int:
    if not args.json:
        eprint("Only `ai-usage status <provider> --json` is supported")
        return 2

    provider_id = args.provider
    provider = build_provider(provider_id, args.auth_file)
    if provider is None:
        eprint(f"Unknown provider: {provider_id}")
        print(
            json.dumps(
                error_payload(provider_id, provider_id, "provider_unavailable", f"Unknown provider: {provider_id}"),
                separators=(",", ":"),
            )
        )
        return 1

    display = getattr(provider, "display_name", provider_id)
    try:
        result = provider.fetch_usage(force_refresh=args.force_refresh)
        if not args.no_cache:
            try:
                write_success(provider_id, result)
            except Exception as exc:  # noqa: BLE001
                eprint(f"cache write skipped: {exc}")
        print(json.dumps(result, separators=(",", ":")))
        return 0
    except ProviderError as exc:
        eprint(exc.message)
        if not args.no_cache:
            stale = stale_payload(provider_id, display, exc.message)
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                return 1
        print(json.dumps(error_payload(provider_id, display, exc.code, exc.message), separators=(",", ":")))
        return 1
    except Exception as exc:  # noqa: BLE001
        eprint(f"collector failure: {exc}")
        if not args.no_cache:
            stale = stale_payload(provider_id, display, "Unexpected collector failure")
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                return 1
        print(
            json.dumps(
                error_payload(provider_id, display, "collector_error", "Unexpected collector failure"),
                separators=(",", ":"),
            )
        )
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="ai-usage", description="Horizon AI usage collector")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="Fetch provider usage status")
    status.add_argument("provider", help="Provider id (e.g. codex)")
    status.add_argument("--json", action="store_true", help="Emit normalized JSON on stdout")
    status.add_argument(
        "--auth-file",
        default=None,
        help="Optional auth path override (Codex: auth.json; Cursor: state.vscdb)",
    )
    status.add_argument(
        "--force-refresh",
        action="store_true",
        help="Force provider credential refresh when supported",
    )
    status.add_argument(
        "--no-cache",
        action="store_true",
        help="Do not read or write the last-successful cache",
    )

    auth = sub.add_parser("auth", help="Manage Horizon-owned provider secrets in the OS store")
    auth.add_argument("provider", help="Provider id (currently: stepfun)")
    auth.add_argument("auth_action", choices=["set", "status", "clear"], help="Auth action")

    args = parser.parse_args(argv)
    if args.command == "auth":
        return cmd_auth(args)
    if args.command == "status":
        return cmd_status(args)
    eprint(f"Unknown command: {args.command}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
