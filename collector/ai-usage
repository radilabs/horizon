#!/usr/bin/env python3
"""Horizon ai-usage collector — provider dispatch + cache + StepFun auth."""

from __future__ import annotations

import argparse
import getpass
import json
import sys
from pathlib import Path

# Allow `collector/ai-usage` to import sibling packages when executed as a script.
_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from cache import stale_payload, write_success  # noqa: E402
from providers import ProviderError, error_payload  # noqa: E402
from providers.claude import ClaudeProvider  # noqa: E402
from providers.codex import CodexProvider  # noqa: E402
from providers.cursor import CursorProvider  # noqa: E402
from providers.mimo import (  # noqa: E402
    DEFAULT_REGION as MIMO_DEFAULT_REGION,
    REGIONS as MIMO_REGIONS,
    SECRET_NAME as MIMO_SECRET_NAME,
    MiMoProvider,
    is_valid_token_plan_key,
)
from providers.stepfun import StepFunProvider  # noqa: E402
from secret_store import SecretStoreError  # noqa: E402
from secret_store import configured as secret_configured  # noqa: E402
from secret_store import delete as secret_delete  # noqa: E402
from secret_store import set as secret_set  # noqa: E402

PROVIDERS = {
    "codex": CodexProvider,
    "cursor": CursorProvider,
    "stepfun": StepFunProvider,
    "claude": ClaudeProvider,
    "mimo": MiMoProvider,
}


def eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


def build_provider(provider_id: str, auth_file: str | None, region: str = MIMO_DEFAULT_REGION):
    cls = PROVIDERS.get(provider_id)
    if cls is None:
        return None
    if provider_id == "codex":
        return cls(auth_path=Path(auth_file).expanduser() if auth_file else None)
    if provider_id == "cursor":
        return cls(state_db=Path(auth_file).expanduser() if auth_file else None)
    if provider_id == "claude":
        return cls(credentials_path=Path(auth_file).expanduser() if auth_file else None)
    if provider_id == "mimo":
        return cls(region=region)
    return cls()


def cmd_auth(args: argparse.Namespace) -> int:
    if args.provider not in ("stepfun", "mimo"):
        eprint("Only `ai-usage auth stepfun|mimo …` is supported")
        return 2
    action = args.auth_action
    if args.provider == "mimo":
        try:
            if action == "set":
                if sys.stdin.isatty():
                    key = getpass.getpass("MiMo Token Plan key: ")
                else:
                    key = sys.stdin.readline()
                key = (key or "").strip()
                if not key or not is_valid_token_plan_key(key):
                    print("invalid")
                    return 1
                secret_set("mimo", MIMO_SECRET_NAME, key)
                try:
                    MiMoProvider(region=args.region).fetch_usage()
                    print("working")
                    return 0
                except ProviderError as exc:
                    if exc.code == "auth_unavailable":
                        print("auth_failed")
                    else:
                        print("unavailable")
                    return 1
                except Exception:  # noqa: BLE001
                    print("unavailable")
                    return 1
            if action == "status":
                if not secret_configured("mimo", MIMO_SECRET_NAME):
                    print("missing")
                    return 0
                try:
                    MiMoProvider(region=args.region).fetch_usage()
                    print("working")
                except ProviderError as exc:
                    if exc.code == "auth_unavailable":
                        print("auth_failed")
                    else:
                        print("unavailable")
                except Exception:  # noqa: BLE001
                    print("unavailable")
                return 0
            if action == "clear":
                secret_delete("mimo", MIMO_SECRET_NAME)
                print("cleared")
                return 0
        except SecretStoreError as exc:
            eprint(str(exc))
            return 1
        eprint(f"Unknown auth action: {action}")
        return 2
    try:
        if action == "set":
            # Never accept --token. Prompt with echo suppressed on a TTY;
            # when stdin is piped (non-TTY), read one line so automation need
            # not put the secret in argv/history.
            if sys.stdin.isatty():
                token = getpass.getpass("Oasis token: ")
            else:
                token = sys.stdin.readline()
            token = (token or "").strip()
            if not token:
                eprint("No token provided")
                return 1
            secret_set("stepfun", "oasis-token", token)
            # Verify without printing secrets. fetch_usage may perform one
            # bounded Oasis refresh and write back only after validation.
            try:
                StepFunProvider().fetch_usage()
                print("working")
                return 0
            except ProviderError as exc:
                if exc.code == "auth_unavailable":
                    print("auth_failed")
                else:
                    print("unavailable")
                return 1
            except Exception:  # noqa: BLE001
                print("unavailable")
                return 1
        if action == "status":
            if not secret_configured("stepfun", "oasis-token"):
                print("missing")
                return 0
            try:
                StepFunProvider().fetch_usage()
                print("working")
            except ProviderError as exc:
                if exc.code == "auth_unavailable":
                    print("auth_failed")
                else:
                    print("unavailable")
            except Exception:  # noqa: BLE001
                print("unavailable")
            return 0
        if action == "clear":
            secret_delete("stepfun", "oasis-token")
            print("cleared")
            return 0
    except SecretStoreError as exc:
        eprint(str(exc))
        return 1
    eprint(f"Unknown auth action: {action}")
    return 2


def cmd_status(args: argparse.Namespace) -> int:
    if not args.json:
        eprint("Only `ai-usage status <provider> --json` is supported")
        return 2

    provider_id = args.provider
    provider = build_provider(provider_id, args.auth_file, region=args.region)
    if provider is None:
        eprint(f"Unknown provider: {provider_id}")
        print(
            json.dumps(
                error_payload(provider_id, provider_id, "provider_unavailable", f"Unknown provider: {provider_id}"),
                separators=(",", ":"),
            )
        )
        return 1

    display = getattr(provider, "display_name", provider_id)
    try:
        result = provider.fetch_usage(force_refresh=args.force_refresh)
        if not args.no_cache:
            try:
                write_success(provider_id, result)
            except Exception as exc:  # noqa: BLE001
                eprint(f"cache write skipped: {exc}")
        print(json.dumps(result, separators=(",", ":")))
        return 0
    except ProviderError as exc:
        eprint(exc.message)
        if not args.no_cache:
            stale = stale_payload(provider_id, display, exc.message)
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                return 1
        print(json.dumps(error_payload(provider_id, display, exc.code, exc.message), separators=(",", ":")))
        return 1
    except Exception as exc:  # noqa: BLE001
        eprint(f"collector failure: {exc}")
        if not args.no_cache:
            stale = stale_payload(provider_id, display, "Unexpected collector failure")
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                return 1
        print(
            json.dumps(
                error_payload(provider_id, display, "collector_error", "Unexpected collector failure"),
                separators=(",", ":"),
            )
        )
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="ai-usage", description="Horizon AI usage collector")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="Fetch provider usage status")
    status.add_argument("provider", help="Provider id (e.g. codex)")
    status.add_argument("--json", action="store_true", help="Emit normalized JSON on stdout")
    status.add_argument(
        "--auth-file",
        default=None,
        help="Optional auth path override (Codex: auth.json; Cursor: state.vscdb; Claude: .credentials.json)",
    )
    status.add_argument(
        "--force-refresh",
        action="store_true",
        help="Force provider credential refresh when supported",
    )
    status.add_argument(
        "--no-cache",
        action="store_true",
        help="Do not read or write the last-successful cache",
    )
    status.add_argument(
        "--region",
        choices=list(MIMO_REGIONS),
        default=MIMO_DEFAULT_REGION,
        help="Region (used by mimo only; default: sgp)",
    )

    auth = sub.add_parser("auth", help="Manage Horizon-owned provider secrets in the OS store")
    auth.add_argument("provider", help="Provider id (stepfun or mimo)")
    auth.add_argument("auth_action", choices=["set", "status", "clear"], help="Auth action")
    auth.add_argument(
        "--region",
        choices=list(MIMO_REGIONS),
        default=MIMO_DEFAULT_REGION,
        help="Region (used by mimo only; default: sgp)",
    )

    args = parser.parse_args(argv)
    if args.command == "auth":
        return cmd_auth(args)
    if args.command == "status":
        return cmd_status(args)
    eprint(f"Unknown command: {args.command}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
