#!/usr/bin/env python3
"""Horizon ai-usage collector — provider dispatch + cache (Phase 2)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Allow `collector/ai-usage` to import sibling packages when executed as a script.
_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from cache import stale_payload, write_success  # noqa: E402
from providers import ProviderError, error_payload  # noqa: E402
from providers.codex import CodexProvider  # noqa: E402

PROVIDERS = {
    "codex": CodexProvider,
}


def eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


def build_provider(provider_id: str, auth_file: str | None):
    cls = PROVIDERS.get(provider_id)
    if cls is None:
        return None
    if provider_id == "codex":
        return cls(auth_path=Path(auth_file).expanduser() if auth_file else None)
    return cls()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="ai-usage", description="Horizon AI usage collector")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="Fetch provider usage status")
    status.add_argument("provider", help="Provider id (e.g. codex)")
    status.add_argument("--json", action="store_true", help="Emit normalized JSON on stdout")
    status.add_argument(
        "--auth-file",
        default=None,
        help="Optional provider auth path override (Codex: auth.json)",
    )
    status.add_argument(
        "--force-refresh",
        action="store_true",
        help="Force provider credential refresh when supported",
    )
    status.add_argument(
        "--no-cache",
        action="store_true",
        help="Do not read or write the last-successful cache",
    )

    args = parser.parse_args(argv)
    if args.command != "status" or not args.json:
        eprint("Only `ai-usage status <provider> --json` is supported")
        return 2

    provider_id = args.provider
    provider = build_provider(provider_id, args.auth_file)
    if provider is None:
        eprint(f"Unknown provider: {provider_id}")
        print(
            json.dumps(
                error_payload(provider_id, provider_id, "provider_unavailable", f"Unknown provider: {provider_id}"),
                separators=(",", ":"),
            )
        )
        return 1

    display = getattr(provider, "display_name", provider_id)
    try:
        result = provider.fetch_usage(force_refresh=args.force_refresh)
        if not args.no_cache:
            try:
                write_success(provider_id, result)
            except Exception as exc:  # noqa: BLE001
                eprint(f"cache write skipped: {exc}")
        print(json.dumps(result, separators=(",", ":")))
        return 0
    except ProviderError as exc:
        eprint(exc.message)
        if not args.no_cache:
            stale = stale_payload(provider_id, display, exc.message)
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                # Non-zero: live failed, even though stale data is useful.
                return 1
        print(json.dumps(error_payload(provider_id, display, exc.code, exc.message), separators=(",", ":")))
        return 1
    except Exception as exc:  # noqa: BLE001
        eprint(f"collector failure: {exc}")
        if not args.no_cache:
            stale = stale_payload(provider_id, display, "Unexpected collector failure")
            if stale is not None:
                print(json.dumps(stale, separators=(",", ":")))
                return 1
        print(
            json.dumps(
                error_payload(provider_id, display, "collector_error", "Unexpected collector failure"),
                separators=(",", ":"),
            )
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
